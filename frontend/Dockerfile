FROM node:24-alpine AS build
WORKDIR /app
ARG VITE_BRAND_ID=crm
ARG VITE_BRAND_NAME
ARG VITE_BRAND_LEGAL_NAME
ARG VITE_BRAND_LOGO_URL
ARG VITE_BRAND_FOOTER_LOGO_URL
ARG VITE_BRAND_PRIMARY
ARG VITE_BRAND_ACCENT
ARG VITE_BRAND_SURFACE
ARG VITE_BRAND_WEBSITE
ARG VITE_BRAND_SUPPORT_EMAIL
ENV VITE_BRAND_ID=$VITE_BRAND_ID \
    VITE_BRAND_NAME=$VITE_BRAND_NAME \
    VITE_BRAND_LEGAL_NAME=$VITE_BRAND_LEGAL_NAME \
    VITE_BRAND_LOGO_URL=$VITE_BRAND_LOGO_URL \
    VITE_BRAND_FOOTER_LOGO_URL=$VITE_BRAND_FOOTER_LOGO_URL \
    VITE_BRAND_PRIMARY=$VITE_BRAND_PRIMARY \
    VITE_BRAND_ACCENT=$VITE_BRAND_ACCENT \
    VITE_BRAND_SURFACE=$VITE_BRAND_SURFACE \
    VITE_BRAND_WEBSITE=$VITE_BRAND_WEBSITE \
    VITE_BRAND_SUPPORT_EMAIL=$VITE_BRAND_SUPPORT_EMAIL
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build
FROM nginx:1.29-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
