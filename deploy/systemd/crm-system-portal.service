[Unit]
Description=CRM System production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/crm-system/current
ExecStart=/usr/bin/docker compose -p crm-system --env-file /opt/crm-system/shared/.env.production -f docker-compose.production.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -p crm-system --env-file /opt/crm-system/shared/.env.production -f docker-compose.production.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
