[Unit]
Description=Renew CRM System TLS certificates
Requires=docker.service
After=docker.service crm-system.service

[Service]
Type=oneshot
WorkingDirectory=/opt/crm-system/current
ExecStart=/usr/bin/docker compose -p crm-system --env-file /opt/crm-system/shared/.env.production -f docker-compose.production.yml run --rm certbot renew --webroot -w /var/www/certbot --quiet
ExecStartPost=/usr/bin/docker compose -p crm-system --env-file /opt/crm-system/shared/.env.production -f docker-compose.production.yml exec -T nginx nginx -s reload
